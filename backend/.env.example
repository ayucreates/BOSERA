NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bosera
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Delhivery One
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_API_URL=https://track.delhivery.com
DELHIVERY_CLIENT_NAME=BOSERA
DELHIVERY_PICKUP_LOCATION=BOSERA


# Temporary Delhivery test route. Set to false or remove after testing.
ENABLE_DELHIVERY_TEST_ROUTE=false
TEST_DELHIVERY_SECRET=change_this_to_a_private_random_password
