NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/lite-bouys-zone
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Delhivery One
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_API_URL=https://track.delhivery.com
DELHIVERY_CLIENT_NAME=Litebouys zone
DELHIVERY_PICKUP_LOCATION=Litebouys zone
