PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/bosera
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ---- Google OAuth (trusted authentication) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. https://your-app.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=

# ---- Admin bootstrap (Role-Based Access Control) ----
# On boot the server will promote/create this user as role=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
